{
  "name": "karal-physics-lab",
  "private": true,
  "version": "1.0.0",
  "description": "Offline-first bilingual physics learning laboratory for Android and web",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync android",
    "cap:android": "cap add android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/app": "7.1.0",
    "@capacitor/core": "7.6.10",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/share": "7.0.4",
    "dexie": "4.4.7",
    "katex": "0.16.25",
    "lucide-react": "0.469.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "@playwright/test": "1.58.0",
    "@types/katex": "0.16.7",
    "@types/node": "22.15.29",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "fake-indexeddb": "6.2.4",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "3.2.7"
  }
}
